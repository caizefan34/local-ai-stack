# ============================================================
# Local AI Stack - Environment Configuration
# Copy this file to .env and adjust values for your setup
# ============================================================

# --- FastGPT ---
ADMIN_PASSWORD=1234
TOKEN_KEY=change-this-to-your-own-secret-key

# --- Database (defaults match docker-compose.yml) ---
MONGODB_URI=mongodb://fastgpt-mongo:27017/fastgpt
PG_HOST=fastgpt-pg
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DB_NAME=postgres
REDIS_URL=redis://fastgpt-redis:6379

# --- Ollama (local LLM server) ---
OLLAMA_HOST=127.0.0.1
OLLAMA_PORT=11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest

# --- Reranker (BGE, local FastAPI service) ---
RERANKER_HOST=0.0.0.0
RERANKER_PORT=18888
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# --- LoRA Fine-tuning ---
LORA_R=16
LORA_ALPHA=32
LORA_DROPOUT=0.05
LORA_TARGET_MODULES=all-linear
LORA_EPOCHS=3
LORA_BATCH_SIZE=4
LORA_LEARNING_RATE=2e-4

# --- Paths (uncomment and adjust as needed) ---
# FASTGPT_CONFIG=./config/fastgpt-config.json
# TRAINING_DATA=./lora-finetune/data/train.json
# OUTPUT_DIR=./lora-finetune/outputs
