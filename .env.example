# ⚠️ 复制此文件为 .env 并修改以下值
# Copy this to .env and edit the values below

# FastGPT 管理员密码
ADMIN_PASSWORD=your-secure-password-here

# JWT 签名密钥（必须修改）
TOKEN_KEY=your-random-token-key-here

# PostgreSQL 密码
POSTGRES_PASSWORD=your-db-password

# MongoDB 连接字符串
MONGODB_URI=mongodb://fastgpt-mongo:27017/fastgpt
