# ============================================================
# Local AI Stack — Environment Configuration
# Copy this file to .env and adjust values for your setup
# ============================================================
#
# Usage:
#   cp .env.example .env    (Linux/macOS)
#   copy .env.example .env  (Windows)
#   docker compose --env-file .env -f docker/docker-compose.yml up -d
#
# All images, ports, passwords, and resource limits can be
# configured below. Defaults match the stock docker-compose.yml.

# =====================
# FastGPT Application
# =====================

# Required: replace with a long, unique password before manual startup.
ADMIN_PASSWORD=replace-with-a-long-unique-password

# Required: replace with a random 32-byte secret before manual startup.
TOKEN_KEY=replace-with-a-random-32-byte-secret

# Bind published services to this host interface. Keep 127.0.0.1 unless
# remote clients must connect and you have configured firewall/authentication.
BIND_ADDRESS=127.0.0.1

# Database ports remain loopback-only even when FastGPT is exposed remotely.
# Changing this is unsafe unless database authentication and firewall rules are configured.
DATABASE_BIND_ADDRESS=127.0.0.1

# FastGPT image tag (matches docker-compose.yml)
FASTGPT_IMAGE=registry.cn-hangzhou.aliyuncs.com/fastgpt/fastgpt:v4.8.9

# FastGPT host port (left side of the port mapping)
FASTGPT_PORT=3000

# =====================
# Database Configuration
# =====================

# --- PostgreSQL + pgvector ---
PG_IMAGE=registry.cn-hangzhou.aliyuncs.com/fastgpt/pgvector:v0.7.0
PG_CONTAINER_NAME=fastgpt-pg
PG_HOST=pg
PG_PORT=5432
PG_HOST_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DB_NAME=postgres
# FastGPT v4.8.9 reads the full connection string PG_URL (usually leave as-is)
PG_URL=postgresql://postgres:postgres@pg:5432/postgres
PG_MEM_LIMIT=512m
PG_CPU_LIMIT=0.5

# --- MongoDB ---
MONGO_IMAGE=registry.cn-hangzhou.aliyuncs.com/fastgpt/mongo:5.0.18
MONGO_CONTAINER_NAME=fastgpt-mongo
MONGO_HOST_PORT=27017
MONGO_MEM_LIMIT=1g
MONGO_CPU_LIMIT=1

# MongoDB connection string (used by FastGPT)
MONGODB_URI=mongodb://mongo:27017/fastgpt

# --- Redis ---
REDIS_IMAGE=docker.m.daocloud.io/library/redis:7.0.11-alpine
REDIS_CONTAINER_NAME=fastgpt-redis
REDIS_HOST_PORT=6379
REDIS_MEM_LIMIT=256m
REDIS_CPU_LIMIT=0.3

# Redis connection string (used by FastGPT)
REDIS_URL=redis://redis:6379

# =====================
# Ollama (Local LLM)
# =====================

OLLAMA_HOST=127.0.0.1
OLLAMA_PORT=11434

# MCP server endpoints (used when launching `python -m mcp_server.server`).
OLLAMA_BASE_URL=http://127.0.0.1:11434
RERANKER_BASE_URL=http://127.0.0.1:18888
FASTGPT_BASE_URL=http://127.0.0.1:3000
LOCAL_AI_REQUEST_TIMEOUT=60
MCP_MAX_PROMPT_CHARS=50000
MCP_MAX_DOCUMENTS=64

# Bounded read-only agent workflows. CLI flags can override the step budget.
AGENT_MAX_STEPS=8

# Authenticated dashboard / control plane (loopback only by default).
CONTROL_PLANE_HOST=127.0.0.1
CONTROL_PLANE_PORT=18080
CONTROL_PLANE_SESSION_HOURS=8
CONTROL_PLANE_DB=./data/control-plane.sqlite3

# Dashboard agent workbench: workspace paths are resolved relative to the
# repository when not absolute. Only Dashboard administrators can run it.
CONTROL_PLANE_AGENT_WORKSPACE=.
CONTROL_PLANE_AGENT_MODELS=qwen3:8b,qwen2.5-coder:7b

# Recommended models. Pass these names to `ollama pull` or select them in the
# authenticated Dashboard model manager; setup scripts use their documented defaults.
OLLAMA_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest

# Additional recommended models (comma-separated, for pull-models scripts)
# OLLAMA_EXTRA_MODELS=qwen3:0.6b,qwen3:1.7b,qwen2.5:14b,deepseek-r1:7b

# =====================
# Reranker (BGE Service)
# =====================

RERANKER_HOST=0.0.0.0
RERANKER_PORT=18888
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# Maximum documents accepted per reranking request (protects CPU and memory).
RERANKER_MAX_DOCUMENTS=256
RERANKER_MAX_DOCUMENT_CHARS=20000
RERANKER_MAX_TOTAL_CHARS=200000

# =====================
# LoRA / QLoRA Fine-Tuning
# =====================

LORA_BASE_MODEL=Qwen/Qwen3-8B
LORA_R=16
LORA_ALPHA=32
LORA_DROPOUT=0.05
LORA_TARGET_MODULES=all-linear
LORA_EPOCHS=3
LORA_BATCH_SIZE=4
LORA_LEARNING_RATE=2e-4
LORA_QUANT=4bit
LORA_MAX_SEQ_LEN=2048
LORA_GRAD_ACCUM=4

# =====================
# Knowledge Base Sync
# =====================

# WSL paths (Linux paths inside WSL)
KB_HOME=~/knowledge-base

# Windows paths (from WSL's /mnt/ mount)
KB_WINDOWS_SOURCE=/mnt/d/knowledge
KB_WINDOWS_REF_SOURCE=/mnt/d/references

# FastGPT dataset name for KB sync
FASTGPT_DATASET_NAME=knowledge_base

# =====================
# FastGPT Config File
# =====================

# Path to FastGPT custom config, relative to docker/docker-compose.yml.
FASTGPT_CONFIG=../config/fastgpt-config.json

# =====================
# Training Data Paths
# =====================

TRAINING_DATA=./lora-finetune/data/train.json
OUTPUT_DIR=./lora-finetune/outputs
